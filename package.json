{
  "name": "twittrapi-mcp",
  "version": "0.4.0",
  "description": "MCP server for TwittrAPI: read public Twitter/X tweets, profiles, followers and search results. Pay as you go from $0.065 per 1,000 calls.",
  "license": "MIT",
  "author": "TwittrAPI",
  "mcpName": "io.github.twittrapi/twittrapi-mcp",
  "type": "module",
  "bin": {
    "twittrapi-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twittrapi/twittrapi-mcp.git"
  },
  "homepage": "https://twittrapi.com",
  "keywords": [
    "twitter api",
    "x api",
    "twitter scraper",
    "tweets",
    "twitter search",
    "twitter followers",
    "social media data",
    "twittrapi",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "npm run build && vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
